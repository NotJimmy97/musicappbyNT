<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="CardShadowColor">#B0B0B0</Color>
    <Color x:Key="AccentBrandColor">#1ED760</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="SubtitleForegroundBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AccentBrandBrush" Color="{StaticResource AccentBrandColor}" />
    <SolidColorBrush x:Key="ListHoverBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ListSelectedBackgroundBrush" Color="#E5E7EB" />

</ResourceDictionary>
