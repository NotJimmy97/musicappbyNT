<UserControl x:Class="SpotifyWpf.Client.Views.NowPlayingCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SpotifyWpf.Client.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="600">

    <UserControl.Resources>
        <!-- Converter ensures all BitmapImage objects are frozen for memory leak prevention -->
        <converters:FrozenImageConverter x:Key="FrozenImageConverter" />

        <!-- Vinyl spin storyboard running natively on DirectX composition engine thread -->
        <Storyboard x:Key="VinylSpinStoryboard">
            <DoubleAnimation Storyboard.TargetName="AlbumCoverRotateTransform"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:10"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" 
                              ShadowDepth="4" 
                              Direction="270" 
                              Opacity="0.4" 
                              Color="{DynamicResource CardShadowColor}" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Circular Vinyl Album Cover with Rotation Transform -->
            <Grid Grid.Column="0" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding CurrentTrack.CoverImageUrl, Converter={StaticResource FrozenImageConverter}}"
                       Stretch="UniformToFill"
                       RenderTransformOrigin="0.5,0.5">
                    <!-- Native circular crop matching border-radius: 50% without off-screen buffer overhead -->
                    <Image.Clip>
                        <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60" />
                    </Image.Clip>
                    <Image.RenderTransform>
                        <RotateTransform x:Name="AlbumCoverRotateTransform" Angle="0" />
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <!-- Metadata, Visualizer & Controls Panel -->
            <Grid Grid.Column="1" Margin="20,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Track Title -->
                <TextBlock Grid.Row="0"
                           Text="{Binding CurrentTrack.Title, FallbackValue='No Track Selected'}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="380"
                           HorizontalAlignment="Left" />

                <!-- Artist and Album -->
                <TextBlock Grid.Row="1"
                           Text="{Binding CurrentTrack.Artist, FallbackValue='Select a track from the catalog'}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0"
                           MaxWidth="380"
                           HorizontalAlignment="Left" />

                <!-- Real-time 16-bin Equalizer Spectrum Visualization -->
                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding EqualizerBins}"
                              VerticalAlignment="Bottom"
                              Margin="0,6,0,6"
                              Height="35">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="8"
                                       Height="{Binding Path=.}"
                                       Margin="2,0"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource AccentBrandBrush}"
                                       VerticalAlignment="Bottom" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Timeline Slider with Duration Labels -->
                <Grid Grid.Row="3" Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="{Binding FormattedPosition, FallbackValue='00:00'}" 
                               FontSize="11" 
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               VerticalAlignment="Center" />

                    <Slider Grid.Column="1" 
                            x:Name="TimelineSlider"
                            Margin="8,0"
                            Minimum="0" 
                            Maximum="{Binding TrackDurationSeconds, FallbackValue=100}" 
                            Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            IsEnabled="{Binding CanSeek}"
                            PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                            PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                            VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2" 
                               Text="{Binding FormattedDuration, FallbackValue='00:00'}" 
                               FontSize="11" 
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Playback Control Action Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Play"
                            Command="{Binding PlayCommand}"
                            Width="70" Height="26"
                            Margin="0,0,8,0"
                            Background="{DynamicResource AccentBrandBrush}"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand" />

                    <Button Content="Pause"
                            Command="{Binding PauseCommand}"
                            Width="70" Height="26"
                            Margin="0,0,8,0"
                            Background="{DynamicResource InputBackgroundBrush}"
                            Foreground="{DynamicResource TitleForegroundBrush}"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand" />

                    <Button Content="Stop"
                            Command="{Binding StopCommand}"
                            Width="70" Height="26"
                            Background="{DynamicResource InputBackgroundBrush}"
                            Foreground="{DynamicResource TitleForegroundBrush}"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
