<Window x:Class="MusicApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MusicApp.Views"
        xmlns:converters="clr-namespace:MusicApp.Converters"
        mc:Ignorable="d"
        Title="MusicApp - Native Desktop Audio Player (.NET 4.6.1)"
        Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <converters:FrozenImageConverter x:Key="FrozenImageConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Search & Theme Control Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Content Track Catalog Area -->
            <RowDefinition Height="*" />
            <!-- Row 2: Fixed Now Playing Player Card -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search Input Box with Real-Time Debounce -->
            <Border Grid.Column="0"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Background="Transparent"
                             Foreground="{DynamicResource TitleForegroundBrush}"
                             BorderThickness="0"
                             VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="Searching..."
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrandBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisConverter}}" />
                </Grid>
            </Border>

            <!-- Explicit Search Button -->
            <Button Grid.Column="1"
                    Content="Search"
                    Command="{Binding SearchCommand}"
                    Width="80" Height="38"
                    Margin="12,0,0,0"
                    Background="{DynamicResource AccentBrandBrush}"
                    Foreground="#FFFFFF"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand" />

            <!-- Dark / Light Theme Toggle Button -->
            <Button Grid.Column="2"
                    Content="{Binding ThemeButtonText}"
                    Command="{Binding ToggleThemeCommand}"
                    Width="110" Height="38"
                    Margin="12,0,0,0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    FontWeight="Medium"
                    Cursor="Hand" />
        </Grid>

        <!-- Track Catalog Results List -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,0,0,16"
                Padding="8">
            <ListBox ItemsSource="{Binding SearchResults}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListSelectedBackgroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail with Frozen BitmapImage -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" ClipToBounds="True">
                                <Image Source="{Binding CoverImageUrl, Converter={StaticResource FrozenImageConverter}}"
                                       Stretch="UniformToFill" />
                            </Border>

                            <!-- Title & Artist -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Album -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Album}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtitleForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="8,0" />

                            <!-- Duration -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding FormattedDuration}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtitleForegroundBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />

                            <!-- Play Track Button -->
                            <Button Grid.Column="4"
                                    Content="Play"
                                    Command="{Binding PlayCommand}"
                                    Width="60" Height="28"
                                    Background="{DynamicResource AccentBrandBrush}"
                                    Foreground="#FFFFFF"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Fixed Bottom Now Playing Player Card -->
        <views:NowPlayingCardView Grid.Row="2" DataContext="{Binding NowPlaying}" />
    </Grid>
</Window>
