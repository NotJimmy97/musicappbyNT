<Window x:Class="MusicApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MusicApp.Views"
        xmlns:converters="clr-namespace:MusicApp.Converters"
        mc:Ignorable="d"
        Title="Jun Music Desktop Player"
        Height="800" Width="1180"
        MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <converters:FrozenImageConverter x:Key="FrozenImageConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Genre Pill Button Style -->
        <Style x:Key="GenrePillButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Template 1: Explore & Vietnamese Music Catalog -->
        <DataTemplate x:Key="ExploreCatalogTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Top Search Bar & Theme Toggle -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: Genre Filter Pills -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 2: Spotify Track Catalog List -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Top Search Bar & Theme Toggle -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <!-- Search Input Area -->
                        <ColumnDefinition Width="*" />
                        <!-- Theme Toggle Button -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="14,6"
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            Width="520">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Icon Symbol -->
                            <TextBlock Grid.Column="0" Text="⚲" FontSize="13" Foreground="{DynamicResource SubtitleForegroundBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />

                            <!-- Search TextBox -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TitleForegroundBrush}"
                                     BorderThickness="0"
                                     VerticalAlignment="Center" />

                            <!-- Searching Indicator -->
                            <TextBlock Grid.Column="2"
                                       Text="Searching..."
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrandBrush}"
                                       VerticalAlignment="Center"
                                       Margin="6,0"
                                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Clear Search Button -->
                            <Button Grid.Column="3"
                                    Command="{Binding ClearSearchCommand}"
                                    Content="✕"
                                    FontSize="11"
                                    Width="20" Height="20"
                                    Background="Transparent"
                                    Foreground="{DynamicResource SubtitleForegroundBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Clear Search" />
                        </Grid>
                    </Border>

                    <!-- Dark / Light Theme Toggle -->
                    <Button Grid.Column="1"
                            Content="{Binding ThemeButtonText}"
                            Command="{Binding ToggleThemeCommand}"
                            Height="36"
                            Padding="16,0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            Foreground="{DynamicResource TitleForegroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="18"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Row 1: Quick Genre Filter Pills Bar -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding Genres}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding DataContext.FilterGenreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GenrePillButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Row 2: Spotify Track Catalog List -->
                <Border Grid.Row="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,0,0,10"
                        Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Table Column Headers -->
                            <RowDefinition Height="Auto" />
                            <!-- List of Tracks -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Column Headers -->
                        <Grid Grid.Row="0" Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="#" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                            <TextBlock Grid.Column="1" Text="COVER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                            <TextBlock Grid.Column="2" Text="TITLE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="3" Text="GENRE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                            <TextBlock Grid.Column="4" Text="ALBUM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                            <TextBlock Grid.Column="5" Text="TIME" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="ACTION" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" HorizontalAlignment="Center" />
                        </Grid>

                        <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="{DynamicResource CardBorderBrush}" Margin="4,0" />

                        <!-- Track List Items -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SearchResults}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="Transparent"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListSelectedBackgroundBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Index/Play indicator -->
                                        <TextBlock Grid.Column="0"
                                                   Text="▶"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AccentBrandBrush}"
                                                   VerticalAlignment="Center" />

                                        <!-- Cover Art Thumbnail with Frozen Image -->
                                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="6" ClipToBounds="True" Background="#161B22">
                                            <Image Source="{Binding CoverImageUrl, Converter={StaticResource FrozenImageConverter}}"
                                                   Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Title & Artist -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TitleForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artist}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SubtitleForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Genre Tag -->
                                        <Border Grid.Column="3"
                                                Background="{DynamicResource CardSurfaceBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Genre}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource AccentBrandBrush}" />
                                        </Border>

                                        <!-- Album -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Album}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SubtitleForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding FormattedDuration}"
                                                   FontSize="12"
                                                   FontFamily="Segoe UI Mono, Consolas"
                                                   Foreground="{DynamicResource SubtitleForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />

                                        <!-- Action Buttons: Play + Add to Queue -->
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Command="{Binding PlayCommand}"
                                                    Content="Play"
                                                    Width="52" Height="28"
                                                    Background="{DynamicResource AccentBrandBrush}"
                                                    Foreground="#FFFFFF"
                                                    FontWeight="SemiBold"
                                                    FontSize="12"
                                                    BorderThickness="0"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Command="{Binding DataContext.EnqueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Track}"
                                                    Content="+"
                                                    ToolTip="Thêm vào hàng đợi"
                                                    Width="28" Height="28"
                                                    Margin="4,0,0,0"
                                                    Background="{DynamicResource CardSurfaceBrush}"
                                                    Foreground="{DynamicResource TitleForegroundBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="14">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Template 2: Local Library Scanner & Offline Playback (Phase 2) -->
        <DataTemplate x:Key="LocalLibraryTemplate">
            <views:LocalLibraryScannerView DataContext="{Binding LocalLibrary}" />
        </DataTemplate>

        <!-- Template 3: Play Queue & Drag-and-Drop (Phase 3) -->
        <DataTemplate x:Key="PlayQueueTemplate">
            <views:PlayQueueView DataContext="{Binding PlayQueue}" />
        </DataTemplate>

        <!-- Template 4: Real-time Synchronized Lyrics (Phase 4) -->
        <DataTemplate x:Key="LyricsTemplate">
            <views:LyricsSyncView DataContext="{Binding Lyrics}" />
        </DataTemplate>
    </Window.Resources>

    <!-- Master Shell Layout: 2-Row Grid (Row 0: 2-Column Work Area, Row 1: Fixed Bottom Player Bar) -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Work Area (Sidebar + Content Area) -->
            <RowDefinition Height="*" />
            <!-- Row 1: Fixed Bottom Spotify-Readme Now Playing Card -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Two-Column Desktop Work Area -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Col 0: Fixed Width Sidebar Navigation (Width=220) -->
                <ColumnDefinition Width="220" />
                <!-- Col 1: Dynamic Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Sidebar Navigation -->
            <views:SidebarNavigationView Grid.Column="0" DataContext="{Binding}" />

            <!-- Column 1: Dynamic Content Area using ContentControl -->
            <Grid Grid.Column="1" Margin="18,16,18,0">
                <ContentControl Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource ExploreCatalogTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentViewName}" Value="Explore">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ExploreCatalogTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentViewName}" Value="VietnameseMusic">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ExploreCatalogTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentViewName}" Value="LocalLibrary">
                                    <Setter Property="ContentTemplate" Value="{StaticResource LocalLibraryTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentViewName}" Value="PlayQueue">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PlayQueueTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentViewName}" Value="Lyrics">
                                    <Setter Property="ContentTemplate" Value="{StaticResource LyricsTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- Row 1: Fixed Bottom Spotify-Readme Now Playing Card -->
        <Border Grid.Row="1" Margin="16,0,16,14">
            <views:NowPlayingCardView DataContext="{Binding NowPlaying}" />
        </Border>
    </Grid>
</Window>
