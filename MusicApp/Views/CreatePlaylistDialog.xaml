<Window x:Class="MusicApp.Views.CreatePlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo Danh Sách Phát Mới"
        Height="280" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Border Padding="24" Background="{DynamicResource CardBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Tạo Danh Sách Phát Mới"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TitleForegroundBrush}"
                       Margin="0,0,0,16" />

            <!-- Playlist Name Input -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Tên danh sách phát *"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="TxtName"
                         Height="36"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TitleForegroundBrush}"
                         BorderBrush="{DynamicResource CardBorderBrush}"
                         BorderThickness="1" />
            </StackPanel>

            <!-- Playlist Description Input -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="Mô tả (tùy chọn)"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="TxtDescription"
                         Height="36"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TitleForegroundBrush}"
                         BorderBrush="{DynamicResource CardBorderBrush}"
                         BorderThickness="1" />
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy Bỏ"
                        Width="90" Height="34"
                        Background="Transparent"
                        Foreground="{DynamicResource SubtitleForegroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Cancel_Click"
                        Margin="0,0,10,0" />

                <Button Content="Tạo Mới"
                        Width="90" Height="34"
                        Background="{DynamicResource AccentBrandBrush}"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Create_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
