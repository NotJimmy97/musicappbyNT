<UserControl x:Class="MusicApp.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:MusicApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <converters:FrozenImageConverter x:Key="FrozenImageConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Banner Header & Stats -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Actions & Search Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Tracks Table List -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Favorites Banner -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Heart Icon Badge -->
                <Border Grid.Column="0"
                        Width="100" Height="100"
                        CornerRadius="12"
                        Background="{DynamicResource CardSurfaceBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,24,0">
                    <Path Data="{StaticResource IconHeartFilled}"
                          Fill="{DynamicResource AccentBrandBrush}"
                          Stretch="Uniform"
                          Width="48" Height="48"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <!-- Details & Stats -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="DANH SÁCH BÀI HÁT YÊU THÍCH"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrandBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Bài Hát Yêu Thích"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalTracksCount, StringFormat='{}{0} bài hát'}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SubtitleForegroundBrush}" />
                        <TextBlock Text=" • "
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Text="{Binding FormattedTotalDuration}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SubtitleForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Actions & Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Play All Button -->
            <Button Grid.Column="0"
                    Command="{Binding PlayAllCommand}"
                    Background="{DynamicResource AccentBrandBrush}"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Height="38"
                    Padding="18,0"
                    Cursor="Hand"
                    Margin="0,0,12,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" />
                                <TextBlock Text="Phát Tất Cả" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Refresh Button -->
            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Content="Làm mới"
                    Height="38"
                    Padding="14,0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Background="{DynamicResource CardSurfaceBrush}"
                    Foreground="{DynamicResource TitleForegroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    Cursor="Hand"
                    Margin="0,0,12,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="19" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Search Filter Box -->
            <TextBox Grid.Column="2"
                     Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="38"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     Padding="14,0"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource TitleForegroundBrush}"
                     BorderBrush="{DynamicResource CardBorderBrush}"
                     BorderThickness="1">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="14,0" />
                                <TextBlock Text="Lọc trong danh sách yêu thích..."
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="16,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Grid>

        <!-- Row 2: Favorite Tracks Virtualized List -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">
            <ListBox ItemsSource="{Binding FavoriteTracks}"
                     SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="ListBox_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ListSelectedBackgroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Play Mini Button -->
                            <Button Grid.Column="0"
                                    Command="{Binding PlayCommand}"
                                    Width="30" Height="30"
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource AccentBrandBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Title & Artist -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Album -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Album}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtitleForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="10,0" />

                            <!-- Duration -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding FormattedDuration}"
                                       FontSize="12"
                                       FontFamily="Segoe UI Mono, Consolas"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,14,0" />

                            <!-- Remove Favorite Button -->
                            <Button Grid.Column="4"
                                    Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Bỏ thích bài hát này"
                                    Width="30" Height="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTrash}"
                                      Fill="{DynamicResource MutedForegroundBrush}"
                                      Stretch="Uniform"
                                      Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
