<UserControl x:Class="MusicApp.Views.NowPlayingCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:MusicApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:FrozenImageConverter x:Key="FrozenImageConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- 10s Continuous Vinyl Spin Storyboard -->
        <Storyboard x:Key="VinylSpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="VinylRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:10" />
        </Storyboard>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20"
            Margin="0,8,0,0">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource CardShadowColor}"
                              BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.35" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Vinyl Disc Area -->
                <ColumnDefinition Width="130" />
                <!-- Metadata, Controls & Visualizer Area -->
                <ColumnDefinition Width="*" />
                <!-- 16-Bar Equalizer Area -->
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Circular Vinyl Disc with Center Pivot Rotation -->
            <Grid Grid.Column="0" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="120" Height="120"
                        CornerRadius="60"
                        Background="#0D0D0D"
                        BorderBrush="#2A2A2A"
                        BorderThickness="2">
                    <Grid>
                        <!-- Grooves -->
                        <Ellipse Width="100" Height="100" Stroke="#1F1F1F" StrokeThickness="1" />
                        <Ellipse Width="80" Height="80" Stroke="#1F1F1F" StrokeThickness="1" />
                        <Ellipse Width="60" Height="60" Stroke="#1F1F1F" StrokeThickness="1" />

                        <!-- Center Album Art with EllipseGeometry Clip -->
                        <Image Width="60" Height="60"
                               Source="{Binding CurrentTrack.CoverImageUrl, Converter={StaticResource FrozenImageConverter}}"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30" />
                            </Image.Clip>
                        </Image>

                        <!-- Center Hole Spindle -->
                        <Ellipse Width="10" Height="10" Fill="#121212" Stroke="#333333" StrokeThickness="1" />
                    </Grid>
                </Border>

                <!-- Center-pivoted RenderTransform for continuous rotation -->
                <Grid.RenderTransformOrigin>
                    <Point X="0.5" Y="0.5" />
                </Grid.RenderTransformOrigin>
                <Grid.RenderTransform>
                    <RotateTransform x:Name="VinylRotation" Angle="0" />
                </Grid.RenderTransform>
            </Grid>

            <!-- Column 1: Track Details, Timeline Slider & Controls -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,20,0">
                <!-- Track Title -->
                <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='No Track Selected'}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TitleForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />

                <!-- Artist and Album -->
                <TextBlock FontSize="13"
                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,12">
                    <Run Text="{Binding CurrentTrack.Artist, FallbackValue='Select a track from the catalog'}" />
                    <Run Text=" • " />
                    <Run Text="{Binding CurrentTrack.Album, FallbackValue='Jamendo Music'}" />
                </TextBlock>

                <!-- Timeline Slider -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding FormattedPosition}"
                               FontSize="11"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <Slider Grid.Column="1"
                            x:Name="TimelineSlider"
                            Minimum="0"
                            Maximum="{Binding TrackDurationSeconds}"
                            Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                            IsEnabled="{Binding CanSeek}"
                            VerticalAlignment="Center"
                            PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                            PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                            Cursor="Hand" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding FormattedDuration}"
                               FontSize="11"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>

                <!-- Playback Buttons Panel -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <!-- Play Button -->
                    <Button Command="{Binding PlayCommand}"
                            Width="44" Height="44"
                            Margin="8,0"
                            Background="{DynamicResource AccentBrandBrush}"
                            Foreground="#FFFFFF"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Fill="#FFFFFF" Data="M 0 0 L 14 8 L 0 16 Z" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </Button>

                    <!-- Pause Button -->
                    <Button Command="{Binding PauseCommand}"
                            Width="44" Height="44"
                            Margin="8,0"
                            Background="{DynamicResource CardBorderBrush}"
                            Foreground="{DynamicResource TitleForegroundBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="4" Height="14" Fill="{DynamicResource TitleForegroundBrush}" Margin="1,0" RadiusX="1" RadiusY="1" />
                            <Rectangle Width="4" Height="14" Fill="{DynamicResource TitleForegroundBrush}" Margin="1,0" RadiusX="1" RadiusY="1" />
                        </StackPanel>
                    </Button>

                    <!-- Stop Button -->
                    <Button Command="{Binding StopCommand}"
                            Width="44" Height="44"
                            Margin="8,0"
                            Background="{DynamicResource CardBorderBrush}"
                            Foreground="{DynamicResource TitleForegroundBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Rectangle Width="12" Height="12" Fill="{DynamicResource TitleForegroundBrush}" RadiusX="2" RadiusY="2" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Column 2: 16-Bar Real-Time Equalizer Spectrum Display -->
            <Border Grid.Column="2"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    Height="80"
                    VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding EqualizerBins}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Bottom">
                                <Rectangle Width="6"
                                           Height="{Binding}"
                                           MaxHeight="68"
                                           Fill="{DynamicResource AccentBrandBrush}"
                                           RadiusX="2" RadiusY="2"
                                           Margin="1.5,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Border>
</UserControl>
