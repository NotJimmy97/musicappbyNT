<UserControl x:Class="MusicApp.Views.PlaylistDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Back Button & Header -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Actions Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Tracks Table List -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header with Back button -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                        Command="{Binding BackCommand}"
                        Width="36" Height="36"
                        Background="{DynamicResource CardSurfaceBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="18">
                                <TextBlock Text="←" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TitleForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Playlist Icon Badge -->
                <Border Grid.Column="1"
                        Width="84" Height="84"
                        CornerRadius="10"
                        Background="{DynamicResource CardSurfaceBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,20,0">
                    <Path Data="{StaticResource IconPlaylist}"
                          Fill="{DynamicResource AccentBrandBrush}"
                          Stretch="Uniform"
                          Width="40" Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <!-- Info Details -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="DANH SÁCH PHÁT"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrandBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Name}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Description, FallbackValue='Không có mô tả'}"
                               FontSize="13"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TracksCount, StringFormat='{}{0} bài hát'}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SubtitleForegroundBrush}" />
                        <TextBlock Text=" • "
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Text="{Binding FormattedTotalDuration}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SubtitleForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Actions Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Command="{Binding PlayAllCommand}"
                    Background="{DynamicResource AccentBrandBrush}"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Height="38"
                    Padding="18,0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" />
                                <TextBlock Text="Phát Toàn Bộ" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Row 2: Tracks Virtualized List -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">
            <ListBox ItemsSource="{Binding PlaylistTracks}"
                     SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="ListBox_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ListSelectedBackgroundBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Play Mini Button -->
                            <Button Grid.Column="0"
                                    Command="{Binding PlayCommand}"
                                    Width="30" Height="30"
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource AccentBrandBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                            <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Title & Artist -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Album -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Album}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtitleForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="10,0" />

                            <!-- Duration -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding FormattedDuration}"
                                       FontSize="12"
                                       FontFamily="Segoe UI Mono, Consolas"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,14,0" />

                            <!-- Remove from Playlist Button -->
                            <Button Grid.Column="4"
                                    Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Xóa bài hát khỏi playlist này"
                                    Width="30" Height="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTrash}"
                                      Fill="{DynamicResource MutedForegroundBrush}"
                                      Stretch="Uniform"
                                      Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
