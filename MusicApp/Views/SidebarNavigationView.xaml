<UserControl x:Class="MusicApp.Views.SidebarNavigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="220"
             Width="220"
             Background="{DynamicResource CardBackgroundBrush}">

    <!--
        KIEN TRUC GIAO DIEN: SidebarNavigationView.xaml - Thanh dieu huong doc ben trai
        
        - Tac dung: Cung cap he thong menu dieu huong chinh cho ung dung, hien thi logo thuong hieu,
          danh sach cac phan he chuc nang (Kham pha, Nhac Viet Nam, Thu vien noi bo, Hang doi, Loi bai hat, Equalizer)
          va thong tin trang thai backend BFF / Audio Engine.
          
        - Van de giai quyet:
          1. Dieu huong tuyen tinh theo mau thiet ke MVVM: Thay vi goi code chuyen trang truc tiep,
             Sidebar su dung ListBox lien ket Two-Way Binding giua SelectedItem va SelectedNavigationItem
             tren MainViewModel.
          2. Phan hoi thi giac linh hoat (Interactive Styling): Su dung ControlTemplate.Triggers tren
             ListBoxItem de xu ly hieu ung hover (ListHoverBackgroundBrush) va selected (AccentBrandBrush)
             giup giao dien phan hoi ngay tuc thi khi tuong tac chuot.
          3. Thiet ke co dinh chieu rong (Fixed Width): Co dinh Width=220px voi duong ke bien Border phai
             ngan cach ro rang giua thanh dieu huong va vung noi dung trung tam.
             
        - Cach thuc van hanh:
          1. ListBox nhan nguon du lieu tu thuoc tinh NavigationItems cua MainViewModel.
          2. Khi nguoi dung bam vao mot dong menu, thuoc tinh SelectedNavigationItem duoc cap nhat,
             tu do kich hoat setter trong MainViewModel de thay doi CurrentViewName va hoan doi DataTemplate tren MainWindow.
    -->

    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="12,16,12,16">
            <Grid.RowDefinitions>
                <!-- Brand Header -->
                <RowDefinition Height="Auto" />
                <!-- Navigation Items -->
                <RowDefinition Height="*" />
                <!-- System Status Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand Header -->
            <StackPanel Grid.Row="0" Margin="4,0,4,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrandBrush}" Margin="0,0,10,0">
                        <TextBlock Text="♫" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JUN MUSIC" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TitleForegroundBrush}" />
                        <TextBlock Text="DESKTOP PLAYER" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Navigation ListBox -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Section: Menu Chinh -->
                    <TextBlock Text="MENU CHÍNH" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SubtitleForegroundBrush}" Margin="8,0,0,6" />

                    <ListBox ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="NavBorder"
                                                    Background="Transparent"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource AccentBrandBrush}" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon Symbol -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding IconSymbol}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />

                                    <!-- Title -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Status Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardSurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#1DB954" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="BFF Online • Port 5245" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TitleForegroundBrush}" />
                    </StackPanel>
                    <TextBlock Text="NAudio Engine • v1.2.0" FontSize="9" Foreground="{DynamicResource SubtitleForegroundBrush}" Margin="12,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

