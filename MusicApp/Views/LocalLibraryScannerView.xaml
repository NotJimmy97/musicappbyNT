<UserControl x:Class="MusicApp.Views.LocalLibraryScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:MusicApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <!--
        KIEN TRUC GIAO DIEN: LocalLibraryScannerView.xaml - Giao dien thu vien nhac ngoai tuyen
        
        - Tac dung: Cung cap man hinh quan ly va phat cac tep nhac luu tru noi bo tren o dia may tinh
          (MP3, FLAC, M4A, WAV, AAC, OGG). Ho tro chon thu muc, quet metadata ID3 bat dong bo,
          tim kiem loc nhanh va them vao danh sach phat.
          
        - Van de giai quyet:
          1. Giao dien chon thu muc & quet khong block UI: Ket noi voi LocalLibraryViewModel qua
             BrowseFolderCommand va ScanFolderCommand. Hien thi thanh ProgressBar va trang thai IsScanning
             giup nguoi dung biet he thong dang quet thu muc tren thread nen.
          2. Bang du lieu chi tiet & Ao hoa danh sach: ListBox duoc cau hinh UI Virtualization
             (VirtualizingStackPanel.VirtualizationMode="Recycling") giup hien thi muot ma danh sach
             hang nghin bai hat noi bo ma khong gay cham may hay ngons RAM.
          3. Thao tac da dang tren tung bai hat: Ho tro nut "Play" phat truc tiep, nut "+" them vao hang doi,
             va nut "Phat tat ca" (PlayAllCommand) de phat toan bo thu muc chi voi mot cu click chuot.
             
        - Cach thuc van hanh:
          1. View nhan DataContext la LocalLibraryViewModel.
          2. Khi go tu khoa vao TextBox loc, thuoc tinh FilterText duoc binding Two-Way,
             kich hoat CollectionView hoac bo loc linq trong ViewModel de cap nhat danh sach hien thi.
    -->

    <UserControl.Resources>
        <converters:FrozenImageConverter x:Key="FrozenImageConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Header & Directory Picker Panel -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Search Filter & Stats Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Tracks Table List -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header & Directory Picker -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Section Title & Subtitle -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="THƯ VIỆN NHẠC CÁ NHÂN"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TitleForegroundBrush}" />
                    <TextBlock Text="Quét và phát các tệp âm thanh ngoại tuyến (MP3, FLAC, M4A, WAV) trực tiếp từ ổ đĩa máy tính."
                               FontSize="12"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Folder Input & Actions -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Path Input Box -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SelectedFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             Padding="12,0"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TitleForegroundBrush}"
                             BorderBrush="{DynamicResource CardBorderBrush}"
                             BorderThickness="1" />

                    <!-- Browse Button -->
                    <Button Grid.Column="1"
                            Command="{Binding BrowseCommand}"
                            Content="Duyệt..."
                            Height="36"
                            Padding="16,0"
                            Margin="8,0,0,0"
                            Background="{DynamicResource CardSurfaceBrush}"
                            Foreground="{DynamicResource TitleForegroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Scan Button -->
                    <Button Grid.Column="2"
                            Command="{Binding ScanCommand}"
                            Content="Bắt đầu quét"
                            Height="36"
                            Padding="18,0"
                            Margin="8,0,0,0"
                            Background="{DynamicResource AccentBrandBrush}"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Cancel Scan Button -->
                    <Button Grid.Column="3"
                            Command="{Binding CancelScanCommand}"
                            Content="Dừng"
                            Height="36"
                            Padding="14,0"
                            Margin="8,0,0,0"
                            Background="#D32F2F"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Cursor="Hand"
                            Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Status & Progress Indicator -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <ProgressBar Height="3"
                                 IsIndeterminate="{Binding IsScanning}"
                                 Foreground="{DynamicResource AccentBrandBrush}"
                                 Background="{DynamicResource CardSurfaceBrush}"
                                 BorderThickness="0"
                                 Margin="0,0,0,6"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource SubtitleForegroundBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Filter Bar & Count -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="BÀI HÁT ĐÃ NHẬN DIỆN"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SubtitleForegroundBrush}" />
                <Border Background="{DynamicResource CardSurfaceBrush}"
                        CornerRadius="10"
                        Padding="8,2"
                        Margin="8,0,0,0">
                    <TextBlock Text="{Binding FilteredTracks.Count, StringFormat='{}{0} bài'}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrandBrush}" />
                </Border>
            </StackPanel>

            <!-- Search in local tracks -->
            <Border Grid.Column="1"
                    Width="250"
                    Height="32"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="10,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="⚲"
                               FontSize="11"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />

                    <TextBox Grid.Column="1"
                             Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TitleForegroundBrush}"
                             FontSize="12"
                             VerticalContentAlignment="Center" />

                    <Button Grid.Column="2"
                            Command="{Binding ClearFilterCommand}"
                            Content="✕"
                            FontSize="10"
                            Foreground="{DynamicResource SubtitleForegroundBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="2"
                            Margin="4,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Local Tracks Table List -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Grid Grid.Row="0" Margin="8,4,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="#" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                    <TextBlock Grid.Column="1" Text="BÌA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                    <TextBlock Grid.Column="2" Text="TIÊU ĐỀ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="3" Text="THỂ LOẠI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                    <TextBlock Grid.Column="4" Text="ALBUM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                    <TextBlock Grid.Column="5" Text="THỜI LƯỢNG" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="THAO TÁC" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" HorizontalAlignment="Center" />
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="{DynamicResource CardBorderBrush}" Margin="4,0" />

                <!-- Empty State Message -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="20">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredTracks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="☷"
                               FontSize="36"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Chưa có bài hát nào trong thư viện"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Chọn thư mục chứa nhạc ở trên và nhấn 'Bắt đầu quét' để tải danh sách bài hát."
                               FontSize="12"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Track List Items -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredTracks}"
                         SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListSelectedBackgroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <!-- Play indicator -->
                                <TextBlock Grid.Column="0"
                                           Text="▶"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrandBrush}"
                                           VerticalAlignment="Center" />

                                <!-- Cover Art Thumbnail with Frozen Image -->
                                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="6" ClipToBounds="True" Background="#161B22">
                                    <Image Source="{Binding CoverImageUrl, Converter={StaticResource FrozenImageConverter}}"
                                           Stretch="UniformToFill" />
                                </Border>

                                <!-- Title & Artist -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Genre Tag -->
                                <Border Grid.Column="3"
                                        Background="{DynamicResource CardSurfaceBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Genre}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource AccentBrandBrush}" />
                                </Border>

                                <!-- Album -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding Album}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />

                                <!-- Duration -->
                                <TextBlock Grid.Column="5"
                                           Text="{Binding FormattedDuration}"
                                           FontSize="12"
                                           FontFamily="Segoe UI Mono, Consolas"
                                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <!-- Action Buttons: Play + Add to Queue -->
                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding PlayCommand}"
                                            Content="Play"
                                            Width="52" Height="28"
                                            Background="{DynamicResource AccentBrandBrush}"
                                            Foreground="#FFFFFF"
                                            FontWeight="SemiBold"
                                            FontSize="12"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Command="{Binding DataContext.EnqueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Track}"
                                            Content="+"
                                            ToolTip="Thêm vào hàng đợi"
                                            Width="28" Height="28"
                                            Margin="4,0,0,0"
                                            Background="{DynamicResource CardSurfaceBrush}"
                                            Foreground="{DynamicResource TitleForegroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
