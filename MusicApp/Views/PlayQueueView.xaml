<UserControl x:Class="MusicApp.Views.PlayQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:converters="clr-namespace:MusicApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <converters:FrozenImageConverter x:Key="FrozenImageConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Header & Summary Actions -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Queue Table / List -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header & Summary Actions -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Drag-and-drop Hint -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="HÀNG ĐỢI PHÁT NHẠC"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TitleForegroundBrush}" />
                        <Border Background="{DynamicResource CardSurfaceBrush}"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding QueueCount, StringFormat='{}{0} bài hát'}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrandBrush}" />
                        </Border>
                        <Border Background="{DynamicResource CardSurfaceBrush}"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding FormattedQueueDuration, StringFormat='Thời lượng: {0}'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SubtitleForegroundBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Kéo và thả chuột trên các dòng bài hát để thay đổi thứ tự ưu tiên phát ngay lập tức."
                               FontSize="12"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Quick Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Play Next in Queue Button -->
                    <Button Command="{Binding PlayNextInQueueCommand}"
                            Content="Phát bài tiếp theo"
                            Height="34"
                            Padding="16,0"
                            Background="{DynamicResource AccentBrandBrush}"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Clear Queue Button -->
                    <Button Command="{Binding ClearQueueCommand}"
                            Content="Xóa toàn bộ"
                            Height="34"
                            Padding="14,0"
                            Margin="8,0,0,0"
                            Background="{DynamicResource CardSurfaceBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource TitleForegroundBrush}"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Queue Table / List -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Grid Grid.Row="0" Margin="8,4,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="" />
                    <TextBlock Grid.Column="1" Text="#" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                    <TextBlock Grid.Column="2" Text="BÌA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                    <TextBlock Grid.Column="3" Text="TIÊU ĐỀ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="4" Text="THỂ LOẠI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                    <TextBlock Grid.Column="5" Text="ALBUM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" />
                    <TextBlock Grid.Column="6" Text="THỜI LƯỢNG" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="THAO TÁC" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtitleForegroundBrush}" HorizontalAlignment="Center" />
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="{DynamicResource CardBorderBrush}" Margin="4,0" />

                <!-- Empty State Message -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="20">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QueueCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="☰"
                               FontSize="36"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Hàng đợi phát nhạc hiện đang trống"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleForegroundBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Nhấn vào nút '+' ở danh sách bài hát để thêm bài vào hàng đợi phát."
                               FontSize="12"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Up Next Drag-and-Drop ListBox -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding QueueTracks}"
                         SelectedItem="{Binding SelectedQueueTrack, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         dd:DragDrop.IsDragSource="True"
                         dd:DragDrop.IsDropTarget="True"
                         dd:DragDrop.DropHandler="{Binding}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListSelectedBackgroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <!-- Drag Handle Grip Symbol -->
                                <TextBlock Grid.Column="0"
                                           Text="⋮⋮"
                                           FontSize="13"
                                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Cursor="SizeAll" />

                                <!-- Play Indicator -->
                                <TextBlock Grid.Column="1"
                                           Text="▶"
                                           FontSize="10"
                                           Foreground="{DynamicResource AccentBrandBrush}"
                                           VerticalAlignment="Center" />

                                <!-- Cover Art Thumbnail with Frozen Image -->
                                <Border Grid.Column="2" Width="42" Height="42" CornerRadius="6" ClipToBounds="True" Background="#161B22">
                                    <Image Source="{Binding CoverImageUrl, Converter={StaticResource FrozenImageConverter}}"
                                           Stretch="UniformToFill" />
                                </Border>

                                <!-- Title & Artist -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0,12,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Genre Tag -->
                                <Border Grid.Column="4"
                                        Background="{DynamicResource CardSurfaceBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Genre}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource AccentBrandBrush}" />
                                </Border>

                                <!-- Album -->
                                <TextBlock Grid.Column="5"
                                           Text="{Binding Album}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />

                                <!-- Duration -->
                                <TextBlock Grid.Column="6"
                                           Text="{Binding FormattedDuration}"
                                           FontSize="12"
                                           FontFamily="Segoe UI Mono, Consolas"
                                           Foreground="{DynamicResource SubtitleForegroundBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <!-- Action Buttons: Play Now & Remove -->
                                <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Play Now Button -->
                                    <Button Command="{Binding DataContext.PlayNowFromQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="▶"
                                            ToolTip="Phát ngay"
                                            Width="28" Height="28"
                                            Background="{DynamicResource AccentBrandBrush}"
                                            Foreground="#FFFFFF"
                                            FontSize="11"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Remove Button -->
                                    <Button Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="✕"
                                            ToolTip="Xóa khỏi hàng đợi"
                                            Width="28" Height="28"
                                            Margin="6,0,0,0"
                                            Background="{DynamicResource CardSurfaceBrush}"
                                            Foreground="{DynamicResource SubtitleForegroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            FontSize="10"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
