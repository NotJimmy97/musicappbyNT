<UserControl x:Class="MusicApp.Views.DspEqualizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <!--
        KIEN TRUC GIAO DIEN: DspEqualizerView.xaml - Giao dien bo loc am sac va am pho thoi gian thuc
        
        - Tac dung: Cung cap man hinh can chinh am thanh chuyen nghiep gom bo loc do hoa 10 dai tan
          (10-Band Graphic Equalizer tu 31Hz den 16kHz) va he thong 16 cot truc quan hoa am pho FFT
          (Real-time Spectrum Visualizer).
          
        - Van de giai quyet:
          1. Slider dieu khien do hoa chuyen biet: Thiet ke lai toan bo ControlTemplate cho Slider doc
             (EqVerticalSliderTemplate) voi moc 0 dB trung tam va pham vi dieu chinh +/-15 dB giup thao tac
             chinh xac va truc quan.
          2. Cau hinh am thanh cai san (Audio Presets): He thong nut bam Preset nhanh (Flat, Bass Boost,
             Vocal, Rock, Pop...) goi SelectPresetCommand giup nguoi dung doi chat am ngay lap tuc.
          3. Truc quan hoa am pho FFT 16 kenh: ItemsControl hien thi 16 cot song bien thien theo bien do
             tan so thuc te do FftCalculator va SampleAggregator trong Audio Engine cung cap.
          4. Tach biet tuyet doi giao dien va DSP Engine: View khong truc tiep tinh toan bo loc ma chi
             nhan du lieu va truyen gia tri qua Two-Way Data Binding vao DspEqualizerViewModel.
             
        - Cach thuc van hanh:
          1. View nhan DataContext la DspEqualizerViewModel.
          2. Khi nguoi dung keo Slider dai tan, gia tri Gain duoc day vao EqualizerBandViewModel,
             tu do cap nhat he so bo loc PeakingEQ trong DspEqualizerSampleProvider thoi gian thuc.
          3. Khi nhac phat, su kien FftCalculated day du lieu sang SpectrumBars de cap nhat chieu cao cot song.
    -->

    <UserControl.Resources>
        <!-- Vertical EQ Slider Thumb Style -->
        <Style x:Key="EqSliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid>
                            <Ellipse Width="18" Height="18" Fill="#FFFFFF">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.4" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrandBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical Slider Template -->
        <ControlTemplate x:Key="EqVerticalSliderTemplate" TargetType="{x:Type Slider}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Track Background Bar -->
                <Border Width="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource CardSurfaceBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3" />

                <!-- Center 0 dB Tick Indicator -->
                <Rectangle Height="2" Width="14"
                           Fill="{DynamicResource SubtitleForegroundBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.6" />

                <!-- Track and Thumb Placement Container -->
                <Track x:Name="PART_Track" Grid.Column="0">
                    <Track.Thumb>
                        <Thumb Style="{StaticResource EqSliderThumbStyle}" />
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <!-- Quick Preset Button Style -->
        <Style x:Key="QuickPresetButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header & Controls -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: 10-Band Sliders Console -->
                <RowDefinition Height="*" />
                <!-- Row 2: Preset Quick-Access Pills -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header with Bypass, Preset, and Reset -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Technical Description -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentBrandBrush}" Margin="0,0,10,0">
                            <TextBlock Text="≡" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="BỘ CHỈNH ÂM ĐỒ HỌA (10-BAND DSP EQUALIZER)"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="BiQuad Peaking EQ thời gian thực (Q = 1.414, 32Hz - 16kHz, phạm vi -12dB đến +12dB)"
                               FontSize="12"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               Margin="38,4,0,0" />
                </StackPanel>

                <!-- Action Controls: Bypass Toggle, Preset Dropdown, Reset Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Bypass / Active Toggle Button -->
                    <Button Height="32"
                            Padding="12,0"
                            Margin="0,0,10,0"
                            Background="{DynamicResource CardSurfaceBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Command="{Binding ToggleBypassCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="16"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#E02424" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentBrandBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Preset Selector Dropdown -->
                    <ComboBox ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              Width="130"
                              Height="32"
                              Margin="0,0,10,0"
                              Background="{DynamicResource CardSurfaceBrush}"
                              Foreground="{DynamicResource TitleForegroundBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"
                              VerticalContentAlignment="Center"
                              Cursor="Hand" />

                    <!-- Reset Flat Button -->
                    <Button Command="{Binding ResetCommand}"
                            Content="Mặc Định (Flat)"
                            Height="32"
                            Padding="14,0"
                            Background="{DynamicResource CardSurfaceBrush}"
                            Foreground="{DynamicResource SubtitleForegroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="16"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: 10 Vertical Equalizer Band Sliders Console -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,20,16,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Scale Indicator Left Column -->
                        <ColumnDefinition Width="40" />
                        <!-- 10 Band Columns -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- dB Scale Reference Labels Column -->
                    <Grid Grid.Column="0" Margin="0,26,8,46">
                        <TextBlock Text="+12 dB" FontSize="9" Foreground="{DynamicResource SubtitleForegroundBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" />
                        <TextBlock Text="+6 dB" FontSize="9" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,0,70" HorizontalAlignment="Right" />
                        <TextBlock Text="0 dB" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TitleForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Text="-6 dB" FontSize="9" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,70,0,0" HorizontalAlignment="Right" />
                        <TextBlock Text="-12 dB" FontSize="9" Foreground="{DynamicResource SubtitleForegroundBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- 10 Bands rendered via ItemsControl inside Grid Columns -->
                    <ItemsControl Grid.Column="1" Grid.ColumnSpan="10" ItemsSource="{Binding Bands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,0">
                                    <Grid.RowDefinitions>
                                        <!-- Row 0: Formatted Gain Value -->
                                        <RowDefinition Height="26" />
                                        <!-- Row 1: Vertical Slider -->
                                        <RowDefinition Height="*" />
                                        <!-- Row 2: Frequency Label -->
                                        <RowDefinition Height="26" />
                                        <!-- Row 3: Band Description -->
                                        <RowDefinition Height="18" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Gain Value Text -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding FormattedGain}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrandBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <!-- Center Vertical Slider -->
                                    <Slider Grid.Row="1"
                                            Orientation="Vertical"
                                            Minimum="-12.0"
                                            Maximum="12.0"
                                            Value="{Binding GainDb, Mode=TwoWay}"
                                            Template="{StaticResource EqVerticalSliderTemplate}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Stretch"
                                            Margin="0,6"
                                            Cursor="Hand" />

                                    <!-- Bottom Frequency Label -->
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Label}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TitleForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <!-- Bottom Band Subtitle -->
                                    <TextBlock Grid.Row="3"
                                               FontSize="9"
                                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Mid" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BandIndex}" Value="0">
                                                        <Setter Property="Text" Value="Sub-Bass" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BandIndex}" Value="1">
                                                        <Setter Property="Text" Value="Bass" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BandIndex}" Value="2">
                                                        <Setter Property="Text" Value="Low-Mid" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BandIndex}" Value="3">
                                                        <Setter Property="Text" Value="Mid" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BandIndex}" Value="4">
                                                        <Setter Property="Text" Value="Mid" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BandIndex}" Value="5">
                                                        <Setter Property="Text" Value="High-Mid" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BandIndex}" Value="6">
                                                        <Setter Property="Text" Value="Presence" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BandIndex}" Value="7">
                                                        <Setter Property="Text" Value="Presence" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BandIndex}" Value="8">
                                                        <Setter Property="Text" Value="Brilliance" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BandIndex}" Value="9">
                                                        <Setter Property="Text" Value="Air" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Row 2: Preset Quick-Access Pills Bar -->
            <Border Grid.Row="2" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="CÀI ĐẶT NHANH:"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SubtitleForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <Button Content="Flat" Command="{Binding ApplyPresetCommand}" CommandParameter="Flat" Style="{StaticResource QuickPresetButtonStyle}" />
                    <Button Content="Bass Boost" Command="{Binding ApplyPresetCommand}" CommandParameter="Bass Boost" Style="{StaticResource QuickPresetButtonStyle}" />
                    <Button Content="Vocal Boost" Command="{Binding ApplyPresetCommand}" CommandParameter="Vocal Boost" Style="{StaticResource QuickPresetButtonStyle}" />
                    <Button Content="Rock" Command="{Binding ApplyPresetCommand}" CommandParameter="Rock" Style="{StaticResource QuickPresetButtonStyle}" />
                    <Button Content="Pop" Command="{Binding ApplyPresetCommand}" CommandParameter="Pop" Style="{StaticResource QuickPresetButtonStyle}" />
                    <Button Content="Jazz" Command="{Binding ApplyPresetCommand}" CommandParameter="Jazz" Style="{StaticResource QuickPresetButtonStyle}" />
                    <Button Content="Classical" Command="{Binding ApplyPresetCommand}" CommandParameter="Classical" Style="{StaticResource QuickPresetButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
