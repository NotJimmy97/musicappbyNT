<UserControl x:Class="MusicApp.Views.PlaylistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:MusicApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- Chế độ 1: Danh sách Playlist dạng Card -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInDetailMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header & Action Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="DANH SÁCH PHÁT CỦA BẠN"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TitleForegroundBrush}" />
                        <TextBlock Text="Tạo và quản lý các danh sách phát cá nhân, phân loại bài hát theo chủ đề hoặc tâm trạng."
                                   FontSize="12"
                                   Foreground="{DynamicResource SubtitleForegroundBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Create Playlist Button -->
                        <Button Command="{Binding CreatePlaylistCommand}"
                                Height="36"
                                Padding="16,0"
                                Background="{DynamicResource AccentBrandBrush}"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconAdd}" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" />
                                            <TextBlock Text="Tạo Playlist Mới" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Refresh Button -->
                        <Button Command="{Binding RefreshCommand}"
                                Content="Làm mới"
                                Height="36"
                                Padding="14,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Background="{DynamicResource CardSurfaceBrush}"
                                Foreground="{DynamicResource TitleForegroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="18" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Playlists Bento / Card Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Playlists}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="240"
                                    Height="170"
                                    Margin="0,0,16,16"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Icon + Delete button -->
                                    <Grid Grid.Row="0">
                                        <Border Width="42" Height="42"
                                                CornerRadius="8"
                                                Background="{DynamicResource CardSurfaceBrush}"
                                                HorizontalAlignment="Left">
                                            <Path Data="{StaticResource IconPlaylist}"
                                                  Fill="{DynamicResource AccentBrandBrush}"
                                                  Stretch="Uniform"
                                                  Width="20" Height="20"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <Button Command="{Binding DataContext.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Xóa playlist này"
                                                Width="28" Height="28"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Cursor="Hand">
                                            <Path Data="{StaticResource IconTrash}"
                                                  Fill="{DynamicResource MutedForegroundBrush}"
                                                  Stretch="Uniform"
                                                  Width="13" Height="13" />
                                        </Button>
                                    </Grid>

                                    <!-- Middle: Title and Description -->
                                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TitleForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description, FallbackValue='Không có mô tả'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SubtitleForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <!-- Bottom: Click to open hint -->
                                    <TextBlock Grid.Row="2"
                                               Text="Nhấn để mở danh sách bài hát →"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource AccentBrandBrush}"
                                               VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Chế độ 2: Chi tiết Playlist được chọn -->
        <ContentControl Content="{Binding CurrentDetail}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInDetailMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <views:PlaylistDetailView />
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>
