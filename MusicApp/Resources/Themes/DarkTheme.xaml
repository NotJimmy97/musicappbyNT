<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Dark Theme Palette -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#181818" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#282828" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#242424" />

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtitleForegroundBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#727272" />

    <!-- Brand Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrandBrush" Color="#1DB954" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1ED760" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#169C46" />

    <!-- List & Interaction Brushes -->
    <SolidColorBrush x:Key="ListHoverBackgroundBrush" Color="#282828" />
    <SolidColorBrush x:Key="ListSelectedBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="SliderTrackBackgroundBrush" Color="#4D4D4D" />

    <!-- Shadow Color -->
    <Color x:Key="CardShadowColor">#000000</Color>

</ResourceDictionary>
