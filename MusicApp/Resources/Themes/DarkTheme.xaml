<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spotify-Readme Authentic Dark Theme Palette (colors.py) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#161B22" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#21262D" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#30363D" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0D1117" />

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtitleForegroundBrush" Color="#8B949E" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#6E7681" />

    <!-- Brand Accent Brushes (Spotify Green) -->
    <SolidColorBrush x:Key="AccentBrandBrush" Color="#1ED760" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#22EC6A" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1AA34A" />

    <!-- List & Interaction Brushes -->
    <SolidColorBrush x:Key="ListHoverBackgroundBrush" Color="#1F242C" />
    <SolidColorBrush x:Key="ListSelectedBackgroundBrush" Color="#282E38" />
    <SolidColorBrush x:Key="SliderTrackBackgroundBrush" Color="#30363D" />

    <!-- Shadow Color -->
    <Color x:Key="CardShadowColor">#000000</Color>

</ResourceDictionary>
