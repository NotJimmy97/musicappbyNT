<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Light Theme Palette -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="#191414" />
    <SolidColorBrush x:Key="SubtitleForegroundBrush" Color="#616161" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#9E9E9E" />

    <!-- Brand Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrandBrush" Color="#1DB954" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1ED760" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#169C46" />

    <!-- List & Interaction Brushes -->
    <SolidColorBrush x:Key="ListHoverBackgroundBrush" Color="#ECEFF1" />
    <SolidColorBrush x:Key="ListSelectedBackgroundBrush" Color="#CFD8DC" />
    <SolidColorBrush x:Key="SliderTrackBackgroundBrush" Color="#CCCCCC" />

    <!-- Shadow Color -->
    <Color x:Key="CardShadowColor">#B0B0B0</Color>

</ResourceDictionary>
